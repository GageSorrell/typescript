declare function count(value: string): number;
>count : (value: string) => number
>value : string

declare function identity<T>(value: T): T;
>identity : <T>(value: T) => T
>value : T

declare function pair(a: number, b: string): { count: number; text: string };
>pair : (a: number, b: string) => { count: number; text: string; }
>a : number
>b : string
>count : number
>text : string

export const size = "abc" |> count;
>size : number
>"abc" |> count : number
>"abc" : "abc"
>count : (value: string) => number

export const result = ...[1, "x"] |> pair;
>result : { count: number; text: string; }
>...[1, "x"] |> pair : { count: number; text: string; }
>...[1, "x"] : string | number
>[1, "x"] : (string | number)[]
>1 : 1
>"x" : "x"
>pair : (a: number, b: string) => { count: number; text: string; }

export const callbackResult = "abc" |> (value => value.length);
>callbackResult : number
>"abc" |> (value => value.length) : number
>"abc" : "abc"
>(value => value.length) : (value: string) => number
>value => value.length : (value: string) => number
>value : string
>value.length : number
>value : string
>length : number

export function generic<T>(value: T) { return value |> identity; }
>generic : <T>(value: T) => T
>value : T
>value |> identity : T
>value : T
>identity : <T_1>(value: T_1) => T_1

declare function merge<T>(a: T, b: T): T;
>merge : <T>(a: T, b: T) => T
>a : T
>b : T

declare function genericPair<T>(a: T, b: T): [T, T];
>genericPair : <T>(a: T, b: T) => [T, T]
>a : T
>b : T

const values = [1, 2];
>values : number[]
>[1, 2] : number[]
>1 : 1
>2 : 2

export const arrayResult = ...[...values] |> merge;
>arrayResult : number
>...[...values] |> merge : number
>...[...values] : number
>[...values] : number[]
>...values : number
>values : number[]
>merge : <T>(a: T, b: T) => T

export function fromArray<T>(values: T[]) { return ...[...values] |> genericPair; }
>fromArray : <T>(values: T[]) => [T, T]
>values : T[]
>...[...values] |> genericPair : [T, T]
>...[...values] : T
>[...values] : T[]
>...values : T
>values : T[]
>genericPair : <T_1>(a: T_1, b: T_1) => [T_1, T_1]

